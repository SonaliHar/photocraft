[
  {
    "id": "org.example.image-gain",
    "manifest": {
      "apiVersion": 1,
      "author": "Example author",
      "description": "A standalone image processor with native and sandboxed backends. Preview before applying.",
      "id": "org.example.image-gain",
      "name": "Image Gain",
      "panel": {
        "buttons": [
          {
            "id": "process",
            "label": "Generate preview"
          }
        ],
        "fields": [
          {
            "default": 1.25,
            "id": "gain",
            "label": "Gain",
            "max": 2.0,
            "min": 0.0,
            "type": "number"
          },
          {
            "default": "Native worker",
            "id": "backend",
            "label": "Processing",
            "options": [
              "Native worker",
              "Sandboxed filter"
            ],
            "type": "choice"
          }
        ],
        "preview": true
      },
      "permissions": {
        "commands": [
          "plugin.processImage"
        ],
        "documentRead": true
      },
      "version": "1.0.0"
    },
    "module": "frozen/image-gain-panel-v1.wasm",
    "request": {
      "document": {
        "activeLayer": 1,
        "depth": 16,
        "height": 6,
        "id": 1,
        "mode": "Rgb",
        "name": "Compatibility fixture",
        "revision": 0,
        "width": 8
      },
      "event": "process",
      "state": {
        "oldState": 7
      },
      "values": {
        "backend": "Sandboxed filter",
        "gain": 0.5
      }
    },
    "response": {
      "commands": [
        {
          "command": "plugin.processImage",
          "params": {
            "options": {
              "gain": 0.5
            },
            "preview": true,
            "processor": "org.example.channel-gain"
          }
        }
      ],
      "message": "Processing image. Compare the preview, then choose Apply or Discard.",
      "state": {
        "oldState": 7
      }
    }
  },
  {
    "id": "org.photocraft.ai-upscale",
    "manifest": {
      "apiVersion": 1,
      "author": "Brandon Gunderson",
      "description": "Enhance detail or enlarge your image with seven local AI models. Preview before applying. Remacri, UltraMix Balanced and UltraSharp are for non-commercial use.",
      "id": "org.photocraft.ai-upscale",
      "name": "AI Upscale",
      "panel": {
        "buttons": [
          {
            "id": "upscale",
            "label": "Generate preview"
          }
        ],
        "fields": [
          {
            "default": "1× · Enhance only",
            "id": "scale",
            "label": "Scale",
            "options": [
              "1× · Enhance only",
              "2×",
              "3×",
              "4×"
            ],
            "type": "choice"
          },
          {
            "default": "Photo · Standard",
            "id": "model",
            "label": "AI model",
            "options": [
              "Photo · Standard",
              "Photo · Fast",
              "Illustration · Digital art",
              "Photo · High Fidelity",
              "Remacri · Non-commercial",
              "UltraMix Balanced · Non-commercial",
              "UltraSharp · Non-commercial"
            ],
            "type": "choice"
          },
          {
            "default": 100,
            "id": "detail",
            "label": "Detail (%)",
            "max": 100,
            "min": 0,
            "type": "int"
          },
          {
            "default": "Local AI (Vulkan)",
            "id": "engine",
            "label": "Processing",
            "options": [
              "Local AI (Vulkan)",
              "Conventional resize (Lanczos)"
            ],
            "type": "choice"
          },
          {
            "default": false,
            "id": "tta",
            "label": "Extra AI passes (slower)",
            "type": "bool"
          }
        ],
        "preview": true
      },
      "permissions": {
        "commands": [
          "plugin.processImage"
        ],
        "documentRead": true
      },
      "version": "2.0.0"
    },
    "module": "frozen/ai-upscale-panel-v1.wasm",
    "request": {
      "document": {
        "activeLayer": 1,
        "depth": 16,
        "height": 6,
        "id": 1,
        "mode": "Rgb",
        "name": "Compatibility fixture",
        "revision": 0,
        "width": 8
      },
      "event": "upscale",
      "state": null,
      "values": {
        "engine": "Conventional resize (Lanczos)"
      }
    },
    "response": {
      "commands": [
        {
          "command": "plugin.processImage",
          "params": {
            "height": 6,
            "options": {
              "detail": 100,
              "engine": "software",
              "model": "upscayl-standard-4x",
              "scale": 1,
              "tile_size": 128,
              "tta": false
            },
            "preview": true,
            "processor": "native",
            "width": 8
          }
        }
      ],
      "message": "",
      "state": {
        "runs": 1
      }
    }
  },
  {
    "id": "org.photocraft.background-removal",
    "manifest": {
      "apiVersion": 1,
      "author": "Brandon Gunderson",
      "description": "Remove the background with local IMG.LY AI. Keep the subject, isolate the background, or create a mask. Preview at the original size, then apply to a new image or layer.",
      "id": "org.photocraft.background-removal",
      "name": "Background Removal",
      "panel": {
        "buttons": [
          {
            "id": "remove",
            "label": "Create result"
          }
        ],
        "fields": [
          {
            "default": "Compact · half precision",
            "id": "model",
            "label": "AI model",
            "options": [
              "Standard · full precision",
              "Compact · half precision",
              "Small · quantized"
            ],
            "type": "choice"
          },
          {
            "default": "Keep subject",
            "id": "output",
            "label": "Result",
            "options": [
              "Keep subject",
              "Keep background",
              "Subject mask"
            ],
            "type": "choice"
          }
        ],
        "preview": true
      },
      "permissions": {
        "commands": [
          "plugin.processImage"
        ],
        "documentRead": true
      },
      "version": "1.1.0"
    },
    "module": "frozen/background-removal-panel-v1.wasm",
    "request": {
      "document": {
        "activeLayer": 1,
        "depth": 16,
        "height": 6,
        "id": 1,
        "mode": "Rgb",
        "name": "Compatibility fixture",
        "revision": 0,
        "width": 8
      },
      "event": "remove",
      "state": null,
      "values": {
        "model": "Small · quantized"
      }
    },
    "response": {
      "commands": [
        {
          "command": "plugin.processImage",
          "params": {
            "options": {
              "model": "isnet_quint8",
              "output": "foreground"
            },
            "preview": true,
            "processor": "native"
          }
        }
      ],
      "message": "",
      "state": {
        "runs": 1
      }
    }
  },
  {
    "id": "org.photocraft.rembg",
    "manifest": {
      "apiVersion": 1,
      "author": "Brandon Gunderson",
      "description": "Choose a model, check its size and status, or download it explicitly. Two models are included. Preview before applying to a new tab or layer. Alpha matting is limited to 4 megapixels.",
      "id": "org.photocraft.rembg",
      "name": "Rembg Background Removal",
      "panel": {
        "buttons": [
          {
            "id": "remove",
            "label": "Generate preview"
          },
          {
            "id": "model_status",
            "label": "Check model status"
          },
          {
            "id": "model_download",
            "label": "Download selected model"
          },
          {
            "id": "model_remove",
            "label": "Remove downloaded model"
          }
        ],
        "fields": [
          {
            "default": "BiRefNet General Lite: General photos with a smaller model",
            "id": "model",
            "label": "AI model",
            "options": [
              "BiRefNet General Lite: General photos with a smaller model",
              "U²-Net Small: Small model for simple general cutouts",
              "U²-Net: General subjects in everyday photos",
              "U²-Net Human: People and full-body silhouettes",
              "Silueta: Smaller U²-Net alternative for general subjects",
              "IS-Net General: General subjects with detailed object outlines",
              "IS-Net Anime: Anime and illustrated characters",
              "BiRefNet General: General subjects using the full BiRefNet model",
              "BiRefNet Portrait: People and portrait cutouts",
              "BiRefNet DIS: Detailed object shapes and boundaries",
              "BiRefNet HRSOD: Prominent subjects in high-resolution photos",
              "BiRefNet COD: Objects that blend into their surroundings",
              "BiRefNet Massive: An alternative for general-purpose photo cutouts"
            ],
            "type": "choice"
          },
          {
            "default": "Keep subject",
            "id": "output",
            "label": "Result",
            "options": [
              "Keep subject",
              "Keep background",
              "Subject mask"
            ],
            "type": "choice"
          },
          {
            "default": false,
            "id": "alpha_matting",
            "label": "Alpha matting (slower)",
            "type": "bool"
          },
          {
            "default": 240,
            "id": "foreground_threshold",
            "label": "Foreground threshold",
            "max": 255,
            "min": 0,
            "type": "int"
          },
          {
            "default": 10,
            "id": "background_threshold",
            "label": "Background threshold",
            "max": 255,
            "min": 0,
            "type": "int"
          },
          {
            "default": 10,
            "id": "erode_size",
            "label": "Edge erosion (px)",
            "max": 50,
            "min": 0,
            "type": "int"
          },
          {
            "default": false,
            "id": "post_process_mask",
            "label": "Post-process mask (hard edges)",
            "type": "bool"
          }
        ],
        "preview": true
      },
      "permissions": {
        "commands": [
          "plugin.processImage",
          "plugin.runTask"
        ],
        "documentRead": true
      },
      "version": "1.1.0"
    },
    "module": "frozen/rembg-panel-v1.wasm",
    "request": {
      "document": {
        "activeLayer": 1,
        "depth": 16,
        "height": 6,
        "id": 1,
        "mode": "Rgb",
        "name": "Compatibility fixture",
        "revision": 0,
        "width": 8
      },
      "event": "remove",
      "state": null,
      "values": {
        "model": "U²-Net Small: Small model for simple general cutouts"
      }
    },
    "response": {
      "commands": [
        {
          "command": "plugin.processImage",
          "params": {
            "height": 6,
            "options": {
              "alpha_matting": false,
              "background_threshold": 10,
              "erode_size": 10,
              "foreground_threshold": 240,
              "model": "u2netp",
              "output": "foreground",
              "post_process_mask": false
            },
            "preview": true,
            "processor": "native",
            "width": 8
          }
        }
      ],
      "message": "Generating a local preview. Compare the result, then Apply or Discard.",
      "state": {
        "runs": 1
      }
    }
  }
]
